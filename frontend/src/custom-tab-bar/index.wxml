<view class="tabbar" wx:if="{{!maskHidden}}">
  <view
    wx:for="{{list}}"
    wx:key="path"
    class="tab-item {{current === item.path ? 'active' : ''}}"
    data-path="{{item.path}}"
    bindtap="switchTab"
  >
    <text class="tab-emoji">{{item.emoji}}</text>
    <text class="tab-text">{{item.label}}</text>
  </view>
</view>
