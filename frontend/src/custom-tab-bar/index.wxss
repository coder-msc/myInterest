.tabbar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 112rpx;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
  background: #ffffff;
  border-top: 1rpx solid #f6efe7;
  display: flex;
  z-index: 999;
}
.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #9c9187;
}
.tab-item.active {
  color: #d97742;
}
.tab-emoji {
  font-size: 38rpx;
  line-height: 1.2;
}
.tab-text {
  font-size: 22rpx;
  line-height: 1.4;
}
.tab-item.active .tab-text {
  font-weight: 600;
}
